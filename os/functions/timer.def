-48 void SubTime(struct timeval *dest, struct timeval *src) (a0,a1)
-54 LONG CmpTime(struct timeval *dest, struct timeval *src) (a0,a1)
-60 ULONG ReadEClock(struct EClockVal *dest) (a0)
-66 void GetSysTime(struct timeval *dest) (a0)
