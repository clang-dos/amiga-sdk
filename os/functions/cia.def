# cia.def: the functions of the CIA resources, ciaa.resource and ciab.resource.
# Each call takes the resource (from OpenResource(CIAANAME) or CIABNAME) as its
# first argument, in a6, so there is no base variable and no proto/cia.h base.
# Offsets and registers: the AmigaOS ABI. Written for amiga-sdk.
nobase
libname cia.resource
include exec/interrupts.h
include exec/libraries.h
-6 struct Interrupt *AddICRVector(struct Library *resource, LONG iCRBit, struct Interrupt *interrupt) (a6,d0,a1)
-12 VOID RemICRVector(struct Library *resource, LONG iCRBit, struct Interrupt *interrupt) (a6,d0,a1)
-18 WORD AbleICR(struct Library *resource, LONG mask) (a6,d0)
-24 WORD SetICR(struct Library *resource, LONG mask) (a6,d0)
