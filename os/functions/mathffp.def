# mathffp.def: the functions of mathffp.library.
# From AROS workbench/libs/mathffp/mathffp.conf (128dae41825d), checked against the AmigaOS ABI with
# tools/ndk-compare.py; maintained by hand. See os/README.md.
base MathBase
basetype struct Library
libname mathffp.library
-30 LONG SPFix(FLOAT fnum) (d0)
-36 FLOAT SPFlt(LONG inum) (d0)
-42 LONG SPCmp(FLOAT fnum1, FLOAT fnum2) (d1,d0)
-48 LONG SPTst(FLOAT fnum) (d1)
-54 FLOAT SPAbs(FLOAT fnum1) (d0)
-60 FLOAT SPNeg(FLOAT fnum1) (d0)
-66 FLOAT SPAdd(FLOAT fnum1, FLOAT fnum2) (d1,d0)
-72 FLOAT SPSub(FLOAT fnum1, FLOAT fnum2) (d1,d0)
-78 FLOAT SPMul(FLOAT fnum1, FLOAT fnum2) (d1,d0)
-84 FLOAT SPDiv(FLOAT fnum1, FLOAT fnum2) (d1,d0)
-90 v33 FLOAT SPFloor(FLOAT y) (d0)
-96 v33 FLOAT SPCeil(FLOAT y) (d0)
